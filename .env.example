# =============================================================
# DexScreener + X Community Scraper — Environment Configuration
# =============================================================

# --- Telegram ---
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Comma-separated user IDs (find yours via @userinfobot)
TELEGRAM_USER_IDS=111111111,222222222

# --- X / Twitter auth ---
# auth_token cookie value from your browser session on x.com
# (DevTools → Application → Cookies → auth_token)
X_AUTH_TOKEN=your_auth_token_here

# --- DexScreener filters ---
FILTER_CHAINS=solana
FILTER_MIN_MCAP=10000
FILTER_MAX_MCAP=10000000
FILTER_MIN_LIQUIDITY=5000
FILTER_MIN_AGE_MINUTES=5
FILTER_MAX_AGE_HOURS=24

# --- Scraper settings ---
SCRAPE_DELAY_MINUTES=60
SCRAPER_HEADLESS=true
SCROLL_WAIT_MS=1500
MAX_PAGEDOWNS=5000

# --- API settings ---
CHECK_INTERVAL=30
API_TIMEOUT=10
